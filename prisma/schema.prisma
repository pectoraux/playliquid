// PlayLiquid — Production Architecture Schema
//
// This schema supports the event-sourced, CQRS architecture:
//   - EventRecord / Snapshot: append-only event store with optimistic concurrency
//   - OutboxMessage: transactional outbox for reliable event publishing
//   - ProjectionCheckpoint: idempotent projection replay tracking
//   - IdempotencyRecord: command deduplication
//   - Read models: materialized projections for the query side

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Event Store ──────────────────────────────────────────────────────────

model EventRecord {
  id              Int      @id @default(autoincrement())
  eventId         String   @unique
  streamId        String
  streamVersion   Int
  eventType       String
  aggregateId     String
  aggregateType   String
  aggregateVersion Int
  payload         String
  metadata        String
  occurredAt      String
  correlationId   String?
  causationId     String?
  createdAt       DateTime @default(now())

  @@unique([streamId, streamVersion])
  @@index([aggregateId])
  @@index([aggregateType])
  @@index([eventType])
  @@index([occurredAt])
}

model Snapshot {
  id            String   @id @default(cuid())
  streamId      String
  version       Int
  aggregateType String
  state         String
  createdAt     DateTime @default(now())

  @@unique([streamId, version])
  @@index([aggregateType])
}

// ─── Outbox ───────────────────────────────────────────────────────────────

model OutboxMessage {
  id          String    @id @default(cuid())
  eventId     String    @unique
  eventType   String
  payload     String
  headers     String
  status      String    @default("pending")
  retryCount  Int       @default(0)
  maxRetries  Int       @default(5)
  error       String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([eventType])
}

// ─── Projection Checkpoints ───────────────────────────────────────────────

model ProjectionCheckpoint {
  id             String   @id @default(cuid())
  projectionName String   @unique
  lastEventId    String?
  lastEventRowId Int      @default(0)
  updatedAt      DateTime @updatedAt
}

// ─── Idempotency ──────────────────────────────────────────────────────────

model IdempotencyRecord {
  id        String   @id @default(cuid())
  key       String   @unique
  result    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// ─── Read Models (materialized projections) ───────────────────────────────

model UserReadModel {
  id          String   @id @default(cuid())
  userId      String   @unique
  email       String   @unique
  username    String   @unique
  displayName String   @default("")
  country     String   @default("")
  timezone    String   @default("UTC")
  locale      String   @default("en")
  status      String   @default("waitlist")
  emailVerified Boolean @default(false)
  mfaEnabled  Boolean  @default(false)
  passwordHash String?
  roles       String   @default("[]")
  isDemo      Boolean  @default(false)
  isPermanent Boolean  @default(false)
  createdAt   String
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@index([username])
  @@index([status])
}

model GameReadModel {
  id          String   @id @default(cuid())
  gameId      String   @unique
  title       String
  creatorId   String
  status      String   @default("draft")
  publishedAt String?
  createdAt   String
  updatedAt   DateTime @updatedAt

  @@index([creatorId])
  @@index([status])
}

model SessionReadModel {
  id              String   @id @default(cuid())
  sessionId       String   @unique
  gameId          String
  playerId        String
  status          String   @default("active")
  durationMinutes Int      @default(0)
  startedAt       String
  endedAt         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([gameId, playerId])
  @@index([status])
}

model WalletReadModel {
  id        String   @id @default(cuid())
  playerId  String   @unique
  balance   Int      @default(0)
  currency  String   @default("USD")
  updatedAt DateTime @updatedAt
}

model LeaderboardEntry {
  id        String   @id @default(cuid())
  gameId    String
  playerId  String
  score     Int
  rank      Int?
  updatedAt DateTime @updatedAt

  @@unique([gameId, playerId])
  @@index([gameId, score])
}

model StatisticsReadModel {
  id        String   @id
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// ─── Dead Letter Queue ────────────────────────────────────────────────────

model DeadLetterMessage {
  id                String   @id
  originalQueue     String
  originalMessageId String
  payload           String
  headers           String
  errorHistory      String
  attempts          Int
  firstFailedAt     BigInt
  lastFailedAt      BigInt
  expiresAt         BigInt
  status            String   @default("pending")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([originalQueue, status])
  @@index([status, expiresAt])
  @@index([lastFailedAt])
}

// ─── Health Check ─────────────────────────────────────────────────────────

model HealthCheck {
  id        String   @id @default(cuid())
  component String   @unique
  status    String   @default("unknown")
  checkedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Scheduled Jobs (Scheduler persistence) ───────────────────────────────

model ScheduledJob {
  id          String   @id @default(cuid())
  jobId       String   @unique
  name        String
  schedule    String
  priority    Int      @default(0)
  enabled     Boolean  @default(true)
  lastRunAt   BigInt?
  nextRunAt   BigInt?
  runCount    Int      @default(0)
  errorCount  Int      @default(0)
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([nextRunAt, enabled])
  @@index([name])
}

// ─── Webhook Registry ─────────────────────────────────────────────────────

model WebhookRegistration {
  id        String   @id @default(cuid())
  url       String
  events    String
  secret    String
  isActive  Boolean  @default(true)
  metadata  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model WebhookDelivery {
  id             String   @id @default(cuid())
  webhookId      String
  payload        String
  attempts       Int      @default(0)
  status         String   @default("pending")
  responseStatus Int?
  responseBody   String?
  deliveredAt    DateTime?
  nextRetryAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([webhookId, status])
  @@index([status, nextRetryAt])
}

// ─── Backup Records ───────────────────────────────────────────────────────

model BackupRecord {
  id           String   @id @default(cuid())
  backupId     String   @unique
  type         String
  status       String
  size         BigInt
  location     String
  checksum     String
  startedAt    DateTime
  completedAt  DateTime
  error        String?
  createdAt    DateTime @default(now())

  @@index([type, createdAt])
}

// ─── Feature Flags ────────────────────────────────────────────────────────

model FeatureFlagRecord {
  id        String   @id @default(cuid())
  key       String   @unique
  type      String
  enabled   Boolean  @default(false)
  config    String
  updatedAt DateTime @updatedAt
}

// ─── M3: Identity — RBAC, API Keys, Audit Log, Devices, Waitlist ───────────

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  permissions String   @default("[]")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
}

model Permission {
  id          String   @id @default(cuid())
  resource    String
  action      String
  description String   @default("")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([resource, action])
  @@index([resource])
}

model ApiKey {
  id          String    @id
  userId      String
  name        String
  keyHash     String    @unique
  keyPrefix   String
  scopes      String    @default("[]")
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  lastUsedIp  String?
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  active      Boolean   @default(true)

  @@index([userId])
  @@index([keyHash])
  @@index([active])
}

model AuditLog {
  id            String   @id @default(cuid())
  action        String
  actorId       String
  actorType     String
  targetType    String
  targetId      String
  timestamp     String
  ipAddress     String?
  userAgent     String?
  metadata      String   @default("{}")
  correlationId String?
  createdAt     DateTime @default(now())

  @@index([actorId, timestamp])
  @@index([targetType, targetId])
  @@index([action])
  @@index([timestamp])
  @@index([correlationId])
}

model Device {
  id            String   @id @default(cuid())
  userId        String
  name          String
  browser       String   @default("")
  os            String   @default("")
  ipAddress     String
  location      String?
  fingerprint   String
  riskScore     Int      @default(0)
  trusted       Boolean  @default(false)
  firstSeenAt   String
  lastSeenAt    String
  revokedAt     String?

  @@unique([userId, fingerprint])
  @@index([userId])
  @@index([fingerprint])
}

model WaitlistEntry {
  id                String   @id @default(cuid())
  email             String   @unique
  username          String
  status            String   @default("pending")
  verificationToken String?
  verifiedAt        String?
  approvalNotes     String?
  rejectionReason   String?
  invitedById       String?
  createdAt         String
  updatedAt         String

  @@index([status])
  @@index([username])
}

model OrganizationReadModel {
  id          String   @id @default(cuid())
  orgId       String   @unique
  name        String
  slug        String   @unique
  type        String
  createdById String
  active      Boolean  @default(true)
  createdAt   String
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([createdById])
}

model OrganizationMemberReadModel {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  roleId    String
  status    String   @default("active")
  joinedAt  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
}

// ─── Launch & Scale Program — Beta Cohorts, Feedback, Validation, etc. ──────

model BetaCohort {
  id              String   @id @default(cuid())
  cohortId        String   @unique
  name            String
  phase           String   @default("closed_beta")
  maxParticipants Int      @default(50)
  createdById     String
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([phase])
  @@index([active])
  @@index([createdById])
}

model CohortParticipant {
  id            String   @id @default(cuid())
  cohortId      String
  invitationId  String   @unique
  userId        String
  email         String
  role          String   @default("player")
  status        String   @default("pending")
  invitedAt     String
  acceptedAt    String?
  expiresAt     String
  createdAt     DateTime @default(now())

  @@index([cohortId])
  @@index([userId])
  @@index([status])
  @@index([email])
}

model FeedbackRecord {
  id           String   @id @default(cuid())
  cohortId     String
  userId       String
  category     String
  severity     String
  title        String
  description  String
  status       String   @default("new")
  assignedTo   String?
  triagedBy    String?
  triagedAt    String?
  triageNotes  String?
  createdAt    String
  updatedAt    String

  @@index([cohortId])
  @@index([userId])
  @@index([status])
  @@index([severity])
  @@index([category])
  @@index([createdAt])
}

model ValidationRun {
  id            String   @id @default(cuid())
  suite         String
  status        String   @default("running")
  totalChecks   Int      @default(0)
  passedChecks  Int      @default(0)
  failedChecks  Int      @default(0)
  durationMs    Int      @default(0)
  triggeredBy   String
  startedAt     String
  completedAt   String?
  report        String   @default("{}")

  @@index([suite])
  @@index([status])
  @@index([startedAt])
}

model ReconciliationReport {
  id                    String   @id @default(cuid())
  period                String
  status                String
  expectedBalance       Int      @default(0)
  actualBalance         Int      @default(0)
  discrepancy           Int      @default(0)
  totalTransactions     Int      @default(0)
  matchedTransactions   Int      @default(0)
  unmatchedTransactions Int      @default(0)
  completedAt           String
  details               String   @default("{}")

  @@index([period])
  @@index([status])
  @@index([completedAt])
}

model SessionReplay {
  id              String   @id @default(cuid())
  sessionId       String
  userId          String
  cohortId        String
  durationSeconds Int      @default(0)
  eventCount      Int      @default(0)
  recordedAt      String
  storageKey      String
  metadata        String   @default("{}")

  @@index([cohortId])
  @@index([userId])
  @@index([recordedAt])
}

model BugReport {
  id          String   @id @default(cuid())
  title       String
  description String
  severity    String
  category    String
  status      String   @default("open")
  reportedBy  String
  cohortId    String
  assignedTo  String?
  resolvedBy  String?
  resolvedAt  String?
  resolution  String?
  createdAt   String
  updatedAt   String

  @@index([severity])
  @@index([status])
  @@index([cohortId])
  @@index([assignedTo])
  @@index([createdAt])
}

model PerformanceMetric {
  id        String   @id @default(cuid())
  metric    String
  value     Float
  unit      String
  threshold Float?
  status    String   @default("ok")
  timestamp String
  metadata  String   @default("{}")

  @@index([metric, timestamp])
  @@index([status])
  @@index([timestamp])
}

